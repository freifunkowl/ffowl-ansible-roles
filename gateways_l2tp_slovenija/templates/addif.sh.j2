#!/bin/bash
INTERFACE="$3"
if grep -Fq "$8" "/srv/tunneldigger/broker/scripts/sperrliste.txt"
then
	echo "$(date '+%F %H:%M:%S') Knoten $8 ist auf Sperrliste, Verbindung von Interface ${INTERFACE}, IP $5, verweigert." >> /var/log/tunneldigger-broker_domain{{item.key}}.log
	exit 0
else
	echo "$(date '+%F %H:%M:%S') Verbindung von Knoten $8 aufgebaut. Interface: ${INTERFACE} IP: $5" >> /var/log/tunneldigger-broker_domain{{item.key}}.log
	ip link set dev $INTERFACE up mtu 1364
	brctl addif br{{item.key}} ${INTERFACE}
fi
